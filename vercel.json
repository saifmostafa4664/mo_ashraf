{
  "version": 2,
  "builds": [
    {
      "src": "api/upload.js",
      "use": "@vercel/node"
    },
    {
      "src": "build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/upload",
      "dest": "/api/upload.js"
    },
    {
      "src": "/",
      "dest": "/build/web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/build/web/$1"
    }
  ]
}